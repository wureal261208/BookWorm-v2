# Server
PORT=5000
NODE_ENV=development

# Set this once you know your deployed frontend's URL, to lock down CORS.
# Leave unset for local dev (defaults to allowing any origin).
# FRONTEND_URL=https://your-frontend.vercel.app

# MongoDB Atlas
# Never commit your real connection string. Copy this file to .env and fill in your own.
# Your existing Atlas cluster already has a database literally named "schema"
# (with collections user_profiles, book_metadata, rentals, payments, notifications,
# reviews) - keep that database name here so the app reuses it instead of creating a new one.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.jve1eql.mongodb.net/schema?retryWrites=true&w=majority

# Uncomment if you hit "querySrv ECONNREFUSED _mongodb._tcp..." - some
# networks/VPNs can't resolve mongodb+srv:// SRV records. This points
# Node's DNS resolver at servers that can, without changing OS settings.
# FORCE_DNS_SERVERS=8.8.8.8,8.8.4.4

# Firebase Admin SDK
# Firebase Console -> Project settings -> Service accounts -> Generate new private key.
# Paste the ENTIRE downloaded JSON as a single line here (escape newlines in the private_key
# field, or just paste the file exactly as Firebase gives it - JSON.parse handles \n fine).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", "...": "..."}
# Alternative to the line above: point to the downloaded file instead.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Default admin account created automatically on server start
DEFAULT_ADMIN_EMAIL=admin@bookworm.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_NAME=BookWorm Admin

# One-time code expiry, in hours
ONE_TIME_CODE_EXPIRES_HOURS=24
FORCE_DNS_SERVERS=8.8.8.8,8.8.4.4
