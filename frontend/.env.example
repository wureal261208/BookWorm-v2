# Firebase web config (not secret - safe to ship in the bundle, protected by
# Firebase Security Rules + authorized domains instead of by being hidden).
# From: Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup and config
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Your backend server (see /backend). No trailing slash.
# Local dev: http://localhost:5000
# Production (Vercel): your deployed backend's URL, e.g. https://bookworm-backend.vercel.app
VITE_API_BASE_URL=http://localhost:5000
